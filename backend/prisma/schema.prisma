generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  orders    Order[]
}

enum Role {
  CUSTOMER
  TAILOR
  ADMIN
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  measurements Measurement[]
}

model Measurement {
  id        String   @id @default(cuid())
  profileId String
  label     String
  chest     Float
  waist     Float
  hips      Float
  shoulder  Float
  sleeveLen Float
  neck      Float
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
  orders  Order[]
}

model Fabric {
  id          String   @id @default(cuid())
  name        String
  material    String
  color       String
  pricePerMtr Float
  stock       Float
  isDeadstock Boolean  @default(false)
  origin      String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  garments Garment[]
}

model Garment {
  id         String   @id @default(cuid())
  name       String
  basePrice  Float
  collar     String
  sleeve     String
  cuff       String
  pocket     String
  buttons    String
  length     String
  embroidery String?
  notes      String?
  fabricId   String
  createdAt  DateTime @default(now())

  fabric Fabric  @relation(fields: [fabricId], references: [id])
  orders Order[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  garmentId     String
  measurementId String
  totalPrice    Float
  status        OrderStatus @default(PAYMENT_PENDING)
  tailorId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  garment     Garment     @relation(fields: [garmentId], references: [id])
  measurement Measurement @relation(fields: [measurementId], references: [id])
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  CUTTING
  STITCHING
  QUALITY_CHECK
  DISPATCHED
  DELIVERED
}